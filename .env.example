# Copy to .env and fill in. Never commit .env.
# On Netlify, set the same names under Site configuration > Environment variables.

# --- Browser (public) ---

# Firebase web API key for project bookthecook-87067 (Project settings > General > Your apps)
FIREBASE_API_KEY=

# Firebase UID of the chef's account (Authentication > Users > User UID).
# Only this account can open Back of House.
NUXT_PUBLIC_CHEF_UID=

# --- Server only (secret) ---

# Service account for bookthecook-87067: Project settings > Service accounts > Generate new private key.
# Copy client_email and private_key from the downloaded JSON. Keep the key on one line with \n
# between lines, wrapped in double quotes. Never commit the JSON file.
NUXT_FIREBASE_CLIENT_EMAIL=
NUXT_FIREBASE_PRIVATE_KEY=

# Resend (resend.com) API key. Until a domain is verified, Resend only delivers to the
# email address the Resend account was registered with, so NOTIFY_EMAIL must be that address.
NUXT_RESEND_API_KEY=
NUXT_NOTIFY_EMAIL=
